{
	"name": "@edaya-spark/api",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"dev:worker": "wrangler dev --port 8787",
		"start": "bun src/main.ts",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@edaya-spark/adaptor-postgres": "workspace:*",
		"@edaya-spark/adaptors": "workspace:*",
		"@edaya-spark/app": "workspace:*",
		"@edaya-spark/domain": "workspace:*",
		"hono": "^4.7.9",
		"jose": "^6.1.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.2",
		"wrangler": "^4.37.0"
	}
}

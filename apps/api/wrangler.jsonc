{
	"name": "children-ai-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"rules": [
		{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"GEMINI_MODEL": "gemini-3.5-flash",
		"CORS_ORIGIN": "http://localhost:5175,http://127.0.0.1:5175",
		"PALIER": "local",
		"EDAYA_API_ORIGIN": "http://localhost:9999",
		"EDAYA_DEMO_SCHOOL_ID": "sch-edaya-ci-cocody",
		"EDAYA_DEMO_ACADEMIC_YEAR_ID": "2025-ci",
		"CHILDREN_AI_RESOLVE_SECRET": "local-children-ai-resolve-secret"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "pglite:.data/spark"
		}
	],
	"env": {
		"staging": {
			"vars": {
				"GEMINI_MODEL": "gemini-3.5-flash",
				"CORS_ORIGIN": "",
				"PALIER": "staging",
				"EDAYA_API_ORIGIN": "https://staging.api.edayaplus.com",
				"EDAYA_DEMO_SCHOOL_ID": "sch-edaya-ci-cocody",
				"EDAYA_DEMO_ACADEMIC_YEAR_ID": "2025-ci"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "11111111111111111111111111111111"
				}
			]
		},
		"prod": {
			"vars": {
				"GEMINI_MODEL": "gemini-3.5-flash",
				"CORS_ORIGIN": "",
				"PALIER": "prod",
				"EDAYA_API_ORIGIN": "https://api.edayaplus.com"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "22222222222222222222222222222222"
				}
			]
		}
	}
}

{
	"name": "edaya-spark-student-web",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"env": {
		"staging": {
			"name": "edaya-spark-app-staging",
			"vars": {
				"PUBLIC_API_URL": "https://staging.api.spark.edayaplus.com",
				"PUBLIC_AUTH_URL": "https://staging.api.edayaplus.com"
			},
			"routes": [
				{
					"pattern": "staging.app.spark.edayaplus.com",
					"custom_domain": true
				}
			]
		},
		"prod": {
			"name": "edaya-spark-student-web",
			"vars": {
				// Public origin of the edaya-spark-api Worker. Add the account subdomain for workers.dev, or use the custom domain.
				"PUBLIC_API_URL": "https://edaya-spark-api-prod.workers.dev",
				"PUBLIC_AUTH_URL": "https://api.edayaplus.com"
			}
		}
	}
}

{
	"name": "edaya-spark",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"package/*"
	],
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:api": "bun --filter @edaya-spark/api dev",
		"dev:web": "bun --filter @edaya-spark/student-web dev",
		"dev:worker": "bun --filter @edaya-spark/api dev:worker",
		"test": "bun test package apps/api",
		"test:integration": "bun test tests/integration",
		"test:integration:ui": "bun tests/integration/ui-run.ts",
		"check": "bun --filter '*' check"
	},
	"dependencies": {
		"@neon/config": "^1.8.4",
		"@neon/env": "^1.5.1"
	},
	"overrides": {
		"@maya-invest/edaya-identity-client": "file:../edaya_identity/package/identity-client"
	},
	"devDependencies": {
		"playwright": "^1.64.1"
	}
}

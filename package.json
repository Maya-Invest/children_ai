{
	"name": "children-ai",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"package/*"
	],
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:api": "bun --filter @children-ai/api dev",
		"dev:web": "bun --filter @children-ai/student-web dev",
		"dev:worker": "bun --filter @children-ai/api dev:worker",
		"test": "bun test package apps/api",
		"check": "bun --filter '*' check"
	},
	"dependencies": {
		"@neon/config": "^1.8.4",
		"@neon/env": "^1.5.1"
	},
	"overrides": {
		"@maya-invest/edaya-identity-client": "file:../edaya_identity/package/identity-client"
	}
}

PORT=8787
PUBLIC_API_URL=http://localhost:8787
DATA_DIR=.data

# Palier for this process (in-memory | local | staging | prod)
PALIER=local

# Allowed EDAYA origin for this palier. Local: http://localhost:9999
# Staging/prod origins are rejected on PALIER=local.
EDAYA_API_ORIGIN=http://localhost:9999

# Parent JWTs are issued by the unified Edaya API (EDAYA_API_ORIGIN). iss and aud are that origin.
# Must match edaya_backend CHILDREN_AI_RESOLVE_SECRET
CHILDREN_AI_RESOLVE_SECRET=local-children-ai-resolve-secret

# demo-ci dataset (Cocody) — a school tenant inside this palier, not a palier itself
EDAYA_DEMO_SCHOOL_ID=sch-edaya-ci-cocody
EDAYA_DEMO_ACADEMIC_YEAR_ID=2025-ci
# After `bun repo seed` on EDAYA (Cocody only). UUID schools use the local derived s2s_live_local_<schoolId>_children_ai01 key.
EDAYA_DEMO_API_KEY=s2s_live_dev_edaya_ci_cocody_children_ai_key01
# fixture | http  (prod always http; local defaults to http when EDAYA_API_ORIGIN is set)
EDAYA_CONTEXT=http

# Palier vault master (required on staging/prod; local has a non-prod default)
# VAULT_MASTER_KEY=

# Gemini Flash — leave empty to keep the stub generator (per palier, not per school)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Extra CORS origins for the Hono API (comma-separated)
CORS_ORIGIN=

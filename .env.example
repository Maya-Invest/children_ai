PORT=8787
PUBLIC_API_URL=http://localhost:8787

# Storage profile, independent of PALIER. local persists under edaya_spark/.data/spark.
RUNTIME=local
DATABASE_URL=pglite:.data/spark

# Palier for this process (local | staging | prod)
PALIER=local

# Allowed EDAYA origin for this palier. Local: http://localhost:9999
# Staging/prod origins are rejected on PALIER=local.
EDAYA_API_ORIGIN=http://localhost:9999

# Parent JWTs are issued by the unified Edaya API (EDAYA_API_ORIGIN). iss and aud are that origin.
# Must match edaya_backend EDAYA_SPARK_RESOLVE_SECRET
EDAYA_SPARK_RESOLVE_SECRET=local-edaya-spark-resolve-secret

# demo-ci dataset (Cocody) — a school tenant inside this palier, not a palier itself
EDAYA_DEMO_SCHOOL_ID=sch-edaya-ci-cocody
EDAYA_DEMO_ACADEMIC_YEAR_ID=2025-ci
# After `bun repo seed` on EDAYA (Cocody only). UUID schools use the local derived s2s_live_local_<schoolId>_edaya_spark01 key.
EDAYA_DEMO_API_KEY=s2s_live_dev_edaya_ci_cocody_edaya_spark_key01
# fixture | http  (prod always http; local defaults to http when EDAYA_API_ORIGIN is set)
EDAYA_CONTEXT=http

# Palier vault master (required on staging/prod; local has a non-prod default)
# VAULT_MASTER_KEY=

# Lesson recommendation. stub follows the timetable locally. cloudflare calls AI Search
# and plans the day between 110 and 130 minutes (prepare_next_day + upcoming_work).
FOCUS=stub
# The first open of the day plans once. Later refreshes read that stored plan.
# Pins the fixture demo to the end of that school day (AAAA-MM-JJ). Ignored when EDAYA_CONTEXT=http.
# FIXTURE_TODAY=2026-10-05
# School day used for tests. Empty follows the real calendar.
# lundi, mardi, mercredi, jeudi, vendredi, samedi, dimanche.
# PRACTICE_WEEKDAY=lundi
# FOCUS_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# RAG_PACK_VERSION=cloudflare-rag

# Exercise generation. stub | gemini | rag. Empty follows GEMINI_API_KEY.
# GENERATOR=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# RAG_GENERATOR_MODEL=google-ai-studio/gemini-3.5-flash
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_RAG_NAMESPACE=default
# CLOUDFLARE_RAG_INSTANCE=
# Stored Gemini key alias on the AI Search gateway (query cf-aig-byok-alias).
# CLOUDFLARE_BYOK_ALIAS=byok

# Extra CORS origins for the Hono API (comma-separated)
CORS_ORIGIN=
